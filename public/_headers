/*
  X-Robots-Tag: noindex

# Astro content-hashes every build asset's filename (e.g.
# global.B_WMU1pF.css) — the hash changes whenever the content does, so
# these are safe to cache forever. Without this, Cloudflare Pages' default
# (max-age=0, must-revalidate) makes every visitor re-download and
# re-validate every CSS/JS file on every single page load.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

---
import "../styles/global.css";

// Static asset paths must go through BASE_URL, not a hardcoded "/", or they
// 404 once this is served at clearcutoff.in/go/*. BASE_URL's trailing slash
// varies with the trailingSlash config, so normalize it here rather than
// assuming one.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Marketing — clearcutoff.in/go</title>
	</head>
	<body class="font-sans text-text-normal">
		<h1 class="text-2xl font-bold p-6">Astro Marketing</h1>
		<p class="px-6 text-text-subtle">Placeholder page — served at clearcutoff.in/go/</p>
	</body>
</html>

    <script>
      // ---- Header: shadow after 10px scroll (mirrors useScrollShadow(10)) ----
      const header = document.getElementById("site-header");
      const onHeaderScroll = () => {
        if (!header) return;
        header.classList.toggle("shadow-md", window.scrollY > 10);
      };
      window.addEventListener("scroll", onHeaderScroll);
      onHeaderScroll();

      // ---- Nav: hover-underline indicator + smooth scroll-to-section ----
      const navMenu = document.getElementById("nav-menu");
      const navIndicator = document.getElementById("nav-indicator");
      if (navMenu && navIndicator) {
        const links = navMenu.querySelectorAll<HTMLElement>(".nav-link");
        links.forEach((link) => {
          link.addEventListener("mouseenter", () => {
            const menuRect = navMenu.getBoundingClientRect();
            const rect = link.getBoundingClientRect();
            navIndicator.style.left = `${rect.left - menuRect.left}px`;
            navIndicator.style.width = `${rect.width}px`;
            navIndicator.style.opacity = "1";
          });
          link.addEventListener("click", () => {
            const id = link.getAttribute("data-scroll-to");
            const el = id && document.getElementById(id);
            if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
          });
        });
        navMenu.addEventListener("mouseleave", () => {
          navIndicator.style.opacity = "0";
        });
      }

      // ---- How it works: highlight the step closest to 20% down the viewport
      // (mirrors src/hooks/useActiveStep.tsx's scroll-listener algorithm) ----
      const stepEls = Array.from(
        document.querySelectorAll<HTMLElement>(".how-it-work-step"),
      );
      const onStepScroll = () => {
        const mid = window.innerHeight / 5;
        let closest: HTMLElement | null = null;
        let minDist = Infinity;
        for (const el of stepEls) {
          const rect = el.getBoundingClientRect();
          const dist = Math.abs(rect.top - mid);
          if (dist < minDist) {
            minDist = dist;
            closest = el;
          }
        }
        for (const el of stepEls) {
          const isActive = el === closest;
          const badgeMobile =
            el.querySelector<HTMLElement>(".step-badge-mobile");
          const badgeDesktop = el.querySelector<HTMLElement>(
            ".step-badge-desktop",
          );
          const line = el.querySelector<HTMLElement>(".step-line-mobile");
          for (const badge of [badgeMobile, badgeDesktop]) {
            if (!badge) continue;
            badge.classList.toggle("bg-brand", isActive);
            badge.classList.toggle("text-white", isActive);
            badge.classList.toggle("bg-gray-300", !isActive);
            badge.classList.toggle("text-gray-600", !isActive);
            badge.classList.toggle("scale-110", isActive);
            badge.classList.toggle("shadow-lg", isActive);
          }
          if (line) {
            line.classList.toggle("bg-brand", isActive);
            line.classList.toggle("bg-gray-300", !isActive);
          }
        }
      };
      window.addEventListener("scroll", onStepScroll);
      onStepScroll();

      // ---- FAQ: tab switching (with sliding pill) + accordion ----
      const tabsContainer = document.getElementById("faq-tabs");
      const tabIndicator = document.getElementById("faq-tab-indicator");
      const tabs = document.querySelectorAll<HTMLElement>(".faq-tab");
      const faqItems = document.querySelectorAll<HTMLElement>(".faq-item");

      function positionTabIndicator(tab: HTMLElement) {
        if (!tabsContainer || !tabIndicator) return;
        const containerRect = tabsContainer.getBoundingClientRect();
        const rect = tab.getBoundingClientRect();
        tabIndicator.style.left = `${rect.left - containerRect.left}px`;
        tabIndicator.style.width = `${rect.width}px`;
        tabIndicator.style.top = `${rect.top - containerRect.top}px`;
        tabIndicator.style.height = `${rect.height}px`;
      }

      function setActiveTab(key: string) {
        tabs.forEach((tab) => {
          const isActive = tab.getAttribute("data-tab") === key;
          tab.classList.toggle("text-text-normal", isActive);
          tab.classList.toggle("font-semibold", isActive);
          tab.classList.toggle("text-white", !isActive);
          if (isActive) positionTabIndicator(tab);
        });
        faqItems.forEach((item) => {
          const matches = item.getAttribute("data-tab-group") === key;
          (item as HTMLElement).style.display = matches ? "" : "none";
          item.setAttribute("data-open", "false");
          item.classList.remove("border-brand");
          item.classList.add("border-gray-200");
          const answer = item.querySelector<HTMLElement>(".faq-answer");
          const chevron = item.querySelector<HTMLElement>(".faq-chevron");
          if (answer) answer.style.display = "none";
          if (chevron) chevron.style.transform = "";
        });
        const firstItem = document.querySelector<HTMLElement>(
          `.faq-item[data-tab-group="${key}"]`,
        );
        if (firstItem) openFaqItem(firstItem);
      }

      function openFaqItem(item: HTMLElement) {
        item.setAttribute("data-open", "true");
        item.classList.add("border-brand");
        item.classList.remove("border-gray-200");
        const answer = item.querySelector<HTMLElement>(".faq-answer");
        const chevron = item.querySelector<HTMLElement>(".faq-chevron");
        if (answer) answer.style.display = "block";
        if (chevron) chevron.style.transform = "rotate(180deg)";
      }

      function closeFaqItem(item: HTMLElement) {
        item.setAttribute("data-open", "false");
        item.classList.remove("border-brand");
        item.classList.add("border-gray-200");
        const answer = item.querySelector<HTMLElement>(".faq-answer");
        const chevron = item.querySelector<HTMLElement>(".faq-chevron");
        if (answer) answer.style.display = "none";
        if (chevron) chevron.style.transform = "";
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const key = tab.getAttribute("data-tab");
          if (key) setActiveTab(key);
        });
      });

      faqItems.forEach((item) => {
        const question = item.querySelector(".faq-question");
        question?.addEventListener("click", () => {
          const isOpen = item.getAttribute("data-open") === "true";
          const group = item.getAttribute("data-tab-group");
          document
            .querySelectorAll<HTMLElement>(
              `.faq-item[data-tab-group="${group}"]`,
            )
            .forEach((el) => {
              if (el !== item) closeFaqItem(el);
            });
          if (isOpen) closeFaqItem(item);
          else openFaqItem(item);
        });
      });

      // Initial state: first tab active, first question open, answer visible.
      if (tabs.length) {
        requestAnimationFrame(() => positionTabIndicator(tabs[0]));
        const firstItem = document.querySelector<HTMLElement>(
          '.faq-item[data-tab-group="refund"]',
        );
        if (firstItem) {
          const answer = firstItem.querySelector<HTMLElement>(".faq-answer");
          const chevron = firstItem.querySelector<HTMLElement>(".faq-chevron");
          if (answer) answer.style.display = "block";
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      }
      window.addEventListener("resize", () => {
        const activeTab = document.querySelector<HTMLElement>(
          ".faq-tab[data-tab].text-text-normal",
        );
        if (activeTab) positionTabIndicator(activeTab);
      });
    </script>
  </body>
</html>

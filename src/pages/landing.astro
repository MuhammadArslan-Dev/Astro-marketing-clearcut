const btnPrimary =
  "relative inline-flex items-center justify-center gap-1.5 rounded-full font-semibold whitespace-nowrap bg-brand text-white transition hover:bg-[#006fdb] active:brightness-90";
const btnOutline =
  "inline-flex items-center justify-center gap-1 rounded-full font-semibold whitespace-nowrap border-2 border-brand text-[#005cb8] bg-transparent transition hover:bg-brand/[0.09]";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="m-0 p-0 font-sans text-text-normal bg-white antialiased">
    <!-- ============ Header ============ -->
    <header
      id="site-header"
      class="bg-white sticky top-0 z-50 transition-shadow duration-300"
    >
      <nav
        class="h-16 max-w-7xl mx-auto px-4 flex items-center justify-between"
      >
        <a href={homeUrl} class="flex items-center">
          <img
            src={`${base}/main-logo.svg`}
            alt="Clear Cutoff"
            width="150"
            height="32"
          />
        </a>
        <div id="nav-menu" class="relative hidden md:flex items-center gap-2">
          <div
            id="nav-indicator"
            class="absolute bottom-0 h-0.5 bg-brand rounded-full transition-all duration-300 ease-out pointer-events-none opacity-0"
          >
          </div>
          {
            navItems.map((item) => (
              <button
                type="button"
                data-scroll-to={item.id}
                class="nav-link relative px-4 py-2 cursor-pointer z-10 text-text-subtle hover:text-brand transition-colors duration-300 body-medium font-semibold"
              >
                {item.label}
              </button>
            ))
          }
        </div>
        <a
          class={`${btnPrimary} hidden md:inline-flex w-[200px] px-4 py-2 text-sm`}
          href={homeUrl}
        >
          Continue Free Prep
          <span set:html={ICONS.arrow} />
        </a>
      </nav>
    </header>

    <main>
      <!-- ============ Hero ============ -->
      <section class="py-8 md:py-16 px-3">
        <div
          class="max-w-[1100px] mx-auto grid md:grid-cols-11 gap-10 md:gap-12 items-center"
        >
          <div
            class="md:col-span-6 order-2 md:order-1 flex flex-col items-center md:items-start text-center md:text-left"
          >
            <h1 class="heading-xlarge font-semibold text-text-normal mb-4">
              Crack the <span class="text-brand">HTET</span> exam with PYQ-based tests,
              notes and videos
            </h1>
            <p class="body-large text-text-subtle mb-8 max-w-lg">

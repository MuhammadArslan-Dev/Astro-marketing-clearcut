		<script>
			// ---- Shimmer CTA buttons: idle until first interaction, then cycle
			// 4.5s arrow-nudge / 2.5s shimmer forever (mirrors useButtonArrowAnimation.ts) ----
			const shimmerBtns = document.querySelectorAll<HTMLElement>(".shimmer-btn");
			if (shimmerBtns.length) {
				let shimmerStarted = false;
				const interactionEvents = ["click", "scroll", "keydown", "touchstart"];
				const startShimmerAnimations = () => {
					if (shimmerStarted) return;
					shimmerStarted = true;
					shimmerBtns.forEach((btn) => {
						const ICON_MS = 4500;
						const SHIMMER_MS = 2500;
						let phase: "icon" | "shimmer" = "icon";
						const applyPhase = () => {
							btn.classList.toggle("btn-phase-icon", phase === "icon");
							btn.classList.toggle("btn-phase-shimmer", phase === "shimmer");
						};
						applyPhase();
						const cycle = () => {
							phase = phase === "icon" ? "shimmer" : "icon";
							applyPhase();
							setTimeout(cycle, phase === "icon" ? ICON_MS : SHIMMER_MS);
						};
						setTimeout(cycle, ICON_MS);
					});
					interactionEvents.forEach((ev) => window.removeEventListener(ev, startShimmerAnimations));
				};
				interactionEvents.forEach((ev) =>
					window.addEventListener(ev, startShimmerAnimations, { once: true, passive: true }),
				);
			}

			// ---- Header: scroll shadow, nav-link sliding indicator + smooth scroll ----
			const header = document.getElementById("site-header");
			const onHeaderScroll = () => {
				if (!header) return;
				header.classList.toggle("shadow-md", window.scrollY > 4);
			};
			window.addEventListener("scroll", onHeaderScroll);
			onHeaderScroll();

			const navIndicator = document.getElementById("nav-indicator");
			const navLinks = document.querySelectorAll<HTMLElement>(".nav-link");
			function positionNavIndicator(el: HTMLElement | null) {
				if (!navIndicator) return;
				if (!el) {
					navIndicator.style.opacity = "0";
					return;
				}
				navIndicator.style.opacity = "1";
				navIndicator.style.left = `${el.offsetLeft}px`;
				navIndicator.style.width = `${el.offsetWidth}px`;
			}
			navLinks.forEach((link) => {
				link.addEventListener("mouseenter", () => positionNavIndicator(link));
				link.addEventListener("click", () => {
					const id = link.getAttribute("data-scroll-to");
					if (id) document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
				});
			});
			document.getElementById("nav-menu")?.addEventListener("mouseleave", () => positionNavIndicator(null));

			// ---- Marquee: CSS-driven, no JS needed beyond what's in global.css ----

			// ---- How-it-works: scroll-driven active-step highlighting ----
			// Port of useActiveStep — finds the step closest to 20% down the
			// viewport and marks it active; mobile gets a plain badge-color
			// swap, desktop additionally scales + shadows the badge.
			const stepEls = document.querySelectorAll<HTMLElement>(".how-it-work-step");
			const onStepScroll = () => {
				if (!stepEls.length) return;
				const target = window.innerHeight * 0.2;
				let closest: HTMLElement | null = null;
				let closestDist = Infinity;
				stepEls.forEach((el) => {
					const rect = el.getBoundingClientRect();
					const dist = Math.abs(rect.top - target);
					if (rect.top < window.innerHeight && rect.bottom > 0 && dist < closestDist) {
						closestDist = dist;
						closest = el;
					}
				});
				stepEls.forEach((el) => {
					const isActive = el === closest;
					const badgeMobile = el.querySelector<HTMLElement>(".step-badge-mobile");
					const badgeDesktop = el.querySelector<HTMLElement>(".step-badge-desktop");
					const line = el.querySelector<HTMLElement>(".step-line-mobile");
					if (badgeMobile) {
						badgeMobile.classList.toggle("bg-brand", isActive);
						badgeMobile.classList.toggle("text-white", isActive);
						badgeMobile.classList.toggle("bg-gray-300", !isActive);
						badgeMobile.classList.toggle("text-gray-700", !isActive);
					}
					if (badgeDesktop) {
						badgeDesktop.classList.toggle("bg-brand", isActive);
						badgeDesktop.classList.toggle("text-white", isActive);
						badgeDesktop.classList.toggle("bg-gray-300", !isActive);
						badgeDesktop.classList.toggle("text-gray-600", !isActive);
						badgeDesktop.classList.toggle("scale-110", isActive);
						badgeDesktop.classList.toggle("shadow-lg", isActive);
					}
					if (line) {
						line.classList.toggle("bg-brand", isActive);
						line.classList.toggle("bg-gray-300", !isActive);
					}
				});
			};
			window.addEventListener("scroll", onStepScroll);
			onStepScroll();

			// Sets an item's open/closed state. Animates the answer's height from
			// 0 to its measured scrollHeight (and back) plus an opacity fade —
			// approximating the source's framer-motion spring (stiffness 120,
			// damping 18 for height, 0.2s fade for opacity) since CSS can't
			// transition to/from `height: auto`. Uses a forced synchronous
			// reflow (`void answer.offsetHeight`) rather than
			// requestAnimationFrame to kick off the transition — rAF was found
			// unreliable earlier in this project (see auth modal below).
			// `animate: false` is used for instant sets (initial load, tab
			// switches) where no visible transition should play.
			const tabsContainer = document.getElementById("faq-tabs");
			const tabIndicator = document.getElementById("faq-tab-indicator");
			const tabs = document.querySelectorAll<HTMLElement>(".faq-tab");
			const faqItems = document.querySelectorAll<HTMLElement>(".faq-item");

			function positionTabIndicator(tab: HTMLElement) {
				if (!tabsContainer || !tabIndicator) return;
				const containerRect = tabsContainer.getBoundingClientRect();
				const rect = tab.getBoundingClientRect();
				tabIndicator.style.left = `${rect.left - containerRect.left}px`;
				tabIndicator.style.width = `${rect.width}px`;
				tabIndicator.style.top = `${rect.top - containerRect.top}px`;
				tabIndicator.style.height = `${rect.height}px`;
			}

			function setFaqItemState(
				item: HTMLElement,
				open: boolean,
				animate: boolean,
			) {
				item.setAttribute("data-open", open ? "true" : "false");
				item.classList.toggle("border-brand", open);
				item.classList.toggle("border-gray-200", !open);
				const answer = item.querySelector<HTMLElement>(".faq-answer");
				const chevron = item.querySelector<HTMLElement>(".faq-chevron");
				if (chevron) chevron.style.transform = open ? "rotate(180deg)" : "";
				if (!answer) return;

				if (!animate) {
					answer.style.transition = "none";
					answer.style.height = open ? "auto" : "0px";
					answer.style.opacity = open ? "1" : "0";
					void answer.offsetHeight;
					answer.style.transition = "";
					return;
				}

				if (open) {
					const target = answer.scrollHeight;
					answer.style.height = "0px";
					answer.style.opacity = "0";
					void answer.offsetHeight;
					answer.style.height = `${target}px`;
					answer.style.opacity = "1";
					const onEnd = (e: TransitionEvent) => {
						if (e.propertyName !== "height") return;
						answer.style.height = "auto";
						answer.removeEventListener("transitionend", onEnd);
					};
					answer.addEventListener("transitionend", onEnd);
				} else {
					const current = answer.getBoundingClientRect().height;
					answer.style.height = `${current}px`;
					void answer.offsetHeight;
					answer.style.height = "0px";
					answer.style.opacity = "0";
				}
			}

			function setActiveTab(key: string) {
				tabs.forEach((tab) => {
					const isActive = tab.getAttribute("data-tab") === key;
					tab.classList.toggle("text-text-normal", isActive);
					tab.classList.toggle("font-semibold", isActive);
					tab.classList.toggle("text-white", !isActive);
					if (isActive) positionTabIndicator(tab);
				});
				faqItems.forEach((item) => {
					const matches = item.getAttribute("data-tab-group") === key;
					item.style.display = matches ? "" : "none";
					setFaqItemState(item, false, false);
				});
				const firstItem = document.querySelector<HTMLElement>(
					`.faq-item[data-tab-group="${key}"]`,
				);
				if (firstItem) setFaqItemState(firstItem, true, false);
			}

			tabs.forEach((tab) => {
				tab.addEventListener("click", () => {
					const key = tab.getAttribute("data-tab");
					if (key) setActiveTab(key);
				});
			});

			faqItems.forEach((item) => {
				const question = item.querySelector(".faq-question");
				question?.addEventListener("click", () => {
					const isOpen = item.getAttribute("data-open") === "true";
					const group = item.getAttribute("data-tab-group");
					document
						.querySelectorAll<HTMLElement>(
							`.faq-item[data-tab-group="${group}"]`,
						)
						.forEach((el) => {
							if (el !== item && el.getAttribute("data-open") === "true") {
								setFaqItemState(el, false, true);
							}
						});
					setFaqItemState(item, !isOpen, true);
				});
			});

			// Initial state: first tab active, first question open, answer visible.
			if (tabs.length) {
				positionTabIndicator(tabs[0]);
				const firstItem = document.querySelector<HTMLElement>(
					'.faq-item[data-tab-group="refund"]',
				);
				if (firstItem) setFaqItemState(firstItem, true, false);
			}
			window.addEventListener("resize", () => {
				const activeTab = document.querySelector<HTMLElement>(
					".faq-tab[data-tab].text-text-normal",
				);
				if (activeTab) positionTabIndicator(activeTab);
			});

			// ---- Auth modal (mirrors login-screen.tsx's phone-entry step) ----
			// Desktop = centered modal, mobile (<768px) = full-screen right-slide
			// panel — both are the SAME markup, just repositioned by Tailwind's
			// md: breakpoint; only the open/close transition direction differs.
			const authOverlay = document.getElementById("auth-overlay");
			const authBackdrop = document.getElementById("auth-backdrop");
			const authPanel = document.getElementById("auth-panel");
			const authInput = document.getElementById("auth-phone-input") as HTMLInputElement | null;
			const authInputWrap = document.getElementById("auth-input-wrap");
			const authSubmit = document.getElementById("auth-submit") as HTMLButtonElement | null;
			const authSubmitLabel = document.getElementById("auth-submit-label");

			function openAuthModal() {
				if (!authOverlay || !authPanel || !authBackdrop) return;
				authOverlay.classList.remove("hidden");
				document.body.style.overflow = "hidden";
				// Force a synchronous style/layout flush before changing the
				// transition classes, so the browser paints the "hidden" removal
				// first and the transform/opacity change gets picked up as a
				// separate style change to transition FROM — otherwise the two
				// changes coalesce into one frame and no transition plays.
				void authOverlay.offsetHeight;
				authBackdrop.classList.remove("bg-black/0");
				authBackdrop.classList.add("bg-black/50");
				authPanel.classList.remove("translate-x-full", "opacity-0", "md:-translate-y-5");
			}

			function closeAuthModal() {
				if (!authOverlay || !authPanel || !authBackdrop) return;
				authBackdrop.classList.remove("bg-black/50");
				authBackdrop.classList.add("bg-black/0");
				authPanel.classList.add("translate-x-full", "opacity-0", "md:-translate-y-5");
				document.body.style.overflow = "";
				setTimeout(() => authOverlay.classList.add("hidden"), 300);
			}

			document.querySelectorAll<HTMLElement>("[data-open-auth]").forEach((btn) => {
				btn.addEventListener("click", openAuthModal);
			});
			authBackdrop?.addEventListener("click", closeAuthModal);
			window.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && authOverlay && !authOverlay.classList.contains("hidden")) closeAuthModal();
			});

			function setInputState(state: "resting" | "focused" | "valid") {
				if (!authInputWrap) return;
				const styles = {
					resting: "border-color:color-mix(in srgb, #6c849d 18%, transparent); background-color:color-mix(in srgb, #6c849d 12%, transparent);",
					focused: "border-color:#0083ff; background-color:rgba(0,123,255,0.1);",
					valid: "border-color:#28a745; background-color:rgba(40,167,69,0.1);",
				};
				authInputWrap.setAttribute("style", `display:flex;align-items:center;gap:0.5rem;border-width:0 0 2px 0;padding:0.375rem 0.75rem;transition:color 0.15s,background-color 0.15s,border-color 0.15s;${styles[state]}`);
			}

			let autoSubmitted = false;
			authInput?.addEventListener("input", () => {
				if (!authInput || !authSubmit) return;
				authInput.value = authInput.value.replace(/\D/g, "").slice(0, 10);
				const isValid = authInput.value.length === 10;
				authSubmit.disabled = !isValid;
				setInputState(isValid ? "valid" : "focused");
				if (isValid && !autoSubmitted) {
					autoSubmitted = true;
					if (authSubmitLabel) authSubmitLabel.textContent = "Redirecting…";
					setTimeout(() => {
						window.location.href = "https://clearcutoff.in";
					}, 500);
				}
			});
			authInput?.addEventListener("focus", () => {
				if (!authInput) return;
				if (authInput.value.length !== 10) setInputState("focused");
			});
			authInput?.addEventListener("blur", () => {
				if (!authInput) return;
				if (authInput.value.length !== 10) setInputState("resting");
			});
		</script>
	</body>
</html>

---
import "../styles/global.css";

// Static asset paths must go through BASE_URL (see src/pages/index.astro
// for why) — normalized here since its trailing slash isn't guaranteed.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const examUrl = "https://clearcutoff.in/exam/htet";
const logoUrl =
	"https://cc-teaching-content-ind.s3.dualstack.ap-south-1.amazonaws.com/exam%20logo/Webp/htet.webp";

const title = "HTET Exam Preparation Online — PYQ Mock Tests, Notes & Videos | Clearcutoff";
const description =
	"Prepare for HTET (Haryana Teacher Eligibility Test) with PYQ-based mock tests, sectional tests, full-length papers, notes and video lessons — all in one place.";

// This page intentionally mirrors the real production course page at
// clearcutoff.in/teaching/htet-v1 (Next.js app, apps/landing) — same
// sections, copy, real pricing and real exam-logo data — rather than an
// original design. See PROJECT_PLAN.md for how each piece maps back to its
// source component.
const S3_LOGOS = "https://cc-teaching-content-ind.s3.dualstack.ap-south-1.amazonaws.com/exam%20logo/Webp";

const trustedLogos = [
	{ name: "HTET", state: "Haryana", logo: `${S3_LOGOS}/htet.webp` },
	{ name: "ugcnet", state: "Haryana", logo: `${S3_LOGOS}/htet.webp` },
	{ name: "REET", state: "Rajasthan", logo: `${S3_LOGOS}/reet.webp` },
	{ name: "CTET", state: "India", logo: `${S3_LOGOS}/ctet.webp` },
	{ name: "UPTET", state: "Uttar Pradesh", logo: `${S3_LOGOS}/uptet.webp` },
	{ name: "HPTET", state: "Himachal Pradesh", logo: `${S3_LOGOS}/hptet.webp` },
	{ name: "UP PGT", state: "Uttar Pradesh", logo: `${S3_LOGOS}/uptet.webp` },
	{ name: "UP TGT", state: "Uttar Pradesh", logo: `${S3_LOGOS}/uptet.webp` },
	{ name: "UGC", state: "India", logo: `${S3_LOGOS}/UGC.webp` },
];

const heroFeatures = [
	"Smart prep for the HTET exam",
	"Full course + test series",
	"Refund assurance policy",
];

const pricingPoints = [
	{
		title: "All subjects included",
		desc: "Study all HTET subjects in one place.",
	},
	{
		title: "Unlimited practice tests",
		desc: "Practise with mini tests, sectional tests and PYQs — and boost your score.",
	},
	{
		title: "Choose your plan",
		desc: "Unlimited access for 6 or 15 months. Study at your own pace, whenever your exam is.",
	},
	{
		title: "3-day free trial before paying",
		desc: "Start preparing for HTET without paying anything.",
	},
];

const ICONS = {
	check:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#00A251"/><path d="M8 12.3l2.5 2.5L16 9.3" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	fire: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0011 17c1.38 0 2.5-1.5 2.5-2.5 0-1.38-1.5-2-1.5-3.5a2 2 0 011-1.5c1.5 1 3 3.5 3 5.5a5 5 0 01-10 0c0-2.5 1.5-4.5 3-6"></path></svg>',
	star: '<svg width="16" height="16" viewBox="0 0 24 24" fill="#f5a623"><path d="M12 2.5l2.9 6.3 6.8.7-5.1 4.7 1.5 6.8-6.1-3.5-6.1 3.5 1.5-6.8-5.1-4.7 6.8-.7z"></path></svg>',
	starGreen:
		'<svg width="16" height="16" viewBox="0 0 24 24" fill="#00A251"><path d="M12 2.5l2.9 6.3 6.8.7-5.1 4.7 1.5 6.8-6.1-3.5-6.1 3.5 1.5-6.8-5.1-4.7 6.8-.7z"></path></svg>',
};

const btnPrimary =
	"inline-flex items-center justify-center gap-1 rounded-full font-semibold whitespace-nowrap px-6 py-3 text-base bg-brand text-white transition hover:bg-brand-dark active:brightness-90";
const btnOutline =
	"inline-flex items-center justify-center gap-1 rounded-full font-semibold whitespace-nowrap px-5 py-2 text-sm bg-brand/10 text-brand border-2 border-brand transition hover:bg-brand/20";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url.href} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content={logoUrl} />
		<meta name="twitter:card" content="summary" />
	</head>
	<body class="m-0 p-0 font-sans text-text-normal bg-white antialiased">
		<header class="border-b border-border-subtle">
			<div class="max-w-[1100px] mx-auto px-3 flex items-center justify-between py-4">
				<span class="font-extrabold text-lg tracking-tight text-text-normal">Clear Cutoff</span>
				<a class={btnPrimary} href={examUrl}>Continue Free Prep »</a>
			</div>
		</header>

		<main>
			<!-- ============ Hero (mirrors CoursePageHero) ============ -->
			<section class="py-9 md:py-20 px-3">
				<div class="max-w-[1100px] mx-auto grid md:grid-cols-11 gap-10 md:gap-12 items-center">
					<div class="md:col-span-6">
						<h1 class="display-small md:display-medium font-semibold text-text-normal mb-4">
							Crack the <span class="text-brand">HTET</span> exam with PYQ-based tests, notes and videos
						</h1>
						<p class="body-large text-text-subtle mb-6">
							Real exam-level questions, sectional tests and full-length papers — all in one place.
						</p>
						<div class="flex flex-col gap-3">
							<div class="flex flex-wrap items-center gap-3">
								<a class={btnPrimary} href={examUrl}>Continue Free Prep »</a>
								<a class={btnOutline} href={examUrl}>3-day free trial</a>
							</div>
							<div class="flex items-center gap-1.5 text-sm text-text-subtle">
								<span set:html={ICONS.fire} />
								No card or payment required
							</div>
						</div>
						<div class="mt-6 inline-flex items-center gap-3 bg-bg-subtle border border-border-subtle rounded-lg px-4 py-2.5">
							<span class="flex items-center gap-1 text-xl font-bold text-text-normal">
								<span set:html={ICONS.star} />
								4.9
							</span>
							<span class="text-xs text-text-muted leading-tight">Average rating given<br />by our students</span>
						</div>
					</div>
					<div class="md:col-span-5 flex flex-col gap-3">
						{
							heroFeatures.map((f) => (
								<div class="flex items-center gap-3 border border-border-subtle bg-brand/[0.03] px-4 py-5 rounded-md">
									<img src={`${base}/badge-green.svg`} alt="" width="20" height="20" />
									<span class="heading-small font-semibold text-text-normal">{f}</span>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- ============ Trusted-by logo marquee (mirrors CourseLogoCarousal) ============ -->
			<section class="py-4">
				<div class="max-w-[1100px] mx-auto px-3 flex flex-col gap-6">
					<h2 class="heading-large font-semibold text-center text-text-normal">
						Trusted by <span class="text-brand">10,000+</span> students to pass TET exams across India
					</h2>
					<div class="overflow-hidden">
						<div class="flex items-center gap-14 w-max animate-marquee">
							{
								[...trustedLogos, ...trustedLogos].map((exam) => (
									<div class="flex flex-col items-center gap-2 flex-shrink-0 w-[88px]">
										<img
											src={exam.logo}
											alt={`${exam.name} logo`}
											width="64"
											height="64"
											class="grayscale opacity-70"
											loading="lazy"
										/>
										<span class="body-large font-semibold text-text-normal text-center">{exam.name}</span>
										<span class="body-xsmall text-text-muted text-center">{exam.state}</span>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- ============ Pricing (mirrors SinglePricingSection) ============ -->
			<section class="bg-bg-subtle">
				<div class="max-w-[1000px] mx-auto px-3 py-8 md:py-14">
					<div class="grid md:grid-cols-10 gap-10 md:gap-12 items-center">
						<div class="md:col-span-6 flex flex-col gap-5">
							<div>
								<p class="text-brand font-semibold text-sm mb-2">Simple. Transparent. Affordable.</p>
								<h2 class="display-small font-semibold text-text-normal">
									<span class="text-brand">One</span> price, <span class="text-brand">everything</span> included!
								</h2>
								<p class="body-large text-text-subtle mt-3">
									Pay once. 6 months of access. Everything you need to pass on the first attempt.
								</p>
							</div>

							<div class="flex flex-col md:flex-row items-center gap-5">
								<img
									src={`${base}/guarantee-badge.webp`}
									alt="Success assurance guarantee badge"
									width="120"
									height="96"
								/>
								<div class="text-center md:text-left">
									<p class="heading-small font-semibold text-text-normal">
										Get a <span class="text-brand underline">refund</span> if you don't pass the exam!
									</p>
									<p class="body-medium text-text-muted">No risk, just results.</p>
								</div>
							</div>

							<div>
								<p class="heading-large font-semibold text-text-normal">
									<span class="text-brand">10,000+</span> students used this to pass the TET exam.
								</p>
								<p class="body-medium text-text-subtle mt-1">
									Join thousands of successful TET aspirants who chose smart, affordable prep over expensive
									coaching!
								</p>
								<p class="flex items-center gap-1.5 body-medium font-semibold text-text-normal mt-2">
									<span set:html={ICONS.starGreen} />
									4.9+ average rating from our students!
								</p>
							</div>
						</div>

						<div class="md:col-span-4 flex justify-center md:justify-end">
							<div class="w-full max-w-[390px] rounded-xl border border-border-subtle bg-white p-6 shadow-sm">
								<h3 class="heading-xlarge font-semibold text-text-normal text-center">exam</h3>
								<hr class="border-t border-border-subtle my-4" />
								<div class="bg-brand/[0.09] rounded-lg h-[72px] flex items-center justify-center gap-4">
									<span class="heading-2xlarge font-semibold text-text-normal">
										<span class="heading-xlarge font-semibold">₹</span>99
									</span>
									<span class="body-large text-text-subtle">6-month subscription</span>
								</div>
								<ul class="flex flex-col gap-3 mt-4">
									{
										pricingPoints.map((p) => (
											<li class="flex items-start gap-3">
												<span class="flex-none mt-0.5" set:html={ICONS.check} />
												<span>
													<span class="block body-large font-semibold text-text-normal">{p.title}</span>
													<span class="block body-medium text-text-subtle">{p.desc}</span>
												</span>
											</li>
										))
									}
								</ul>
								<hr class="border-t border-border-subtle my-4" />
								<a class={`${btnPrimary} w-full`} href={examUrl}>Start for free »</a>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
	</body>
</html>
